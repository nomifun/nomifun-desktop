+
+struct FallbackWindow {
+    viewable: bool,
+    wm_managed: bool,
+    children: Vec<Window>,
+}
+
+fn fallback_window_list(
+    root_children: Vec<Window>,
+    mut inspect: impl FnMut(Window) -> Option<FallbackWindow>,
+) -> Vec<Window> {
+    let mut windows = Vec::new();
+    for root_child in root_children {
+        let before = windows.len();
+        let mut root_viewable = false;
+        let mut pending = vec![root_child];
+        let mut visited = std::collections::HashSet::new();
+        while let Some(window) = pending.pop() {
+            if !visited.insert(window) { continue; }
+            let Some(node) = inspect(window) else { continue };
+            if window == root_child { root_viewable = node.viewable; }
+            if !node.viewable { continue; }
+            if node.wm_managed {
+                windows.push(window);
+            } else {
+                // QueryTree order is bottom-to-top. Reverse only the DFS stack
+                // so the resulting client order retains that stacking order.
+                pending.extend(node.children.into_iter().rev());
+            }
+        }
+        if windows.len() == before && root_viewable {
+            windows.push(root_child);
+        }
+    }
+    windows
+}
+
+fn has_managed_wm_state(conn: &RustConnection, window: Window, atom: Atom) -> bool {
+    let Some(reply) = conn.get_property(false, window, atom, atom, 0, 2)
+        .ok().and_then(|cookie| cookie.reply().ok()) else { return false };
+    let values: Vec<u32> = reply.value32().map(|values| values.collect()).unwrap_or_default();
+    reply.type_ == atom && reply.format == 32 && reply.bytes_after == 0
+        && values.len() == 2 && matches!(values[0], 1 | 3)
 }
 
