{
  "schema_version": "1.0.0",
  "manifest_kind": "machine_two_batch",
  "batch_id": "phase1-batch-a",
  "status": "ready_when_all_tasks_are_accepted",
  "authority": {
    "design": "docs/specs/2026-08-28-agent-capability-platform-v2/05-system-capability-replacement-foundation.zh.md",
    "status": "docs/specs/2026-08-28-agent-capability-platform-v2/GLOBAL-CLOSURE-TODO.zh.md",
    "operator_prompt": "docs/specs/2026-08-28-agent-capability-platform-v2/MACHINE-2-PHASE1-BATCH-A-START-PROMPT.zh.md"
  },
  "source": {
    "integration_branch": "rf/m2-phase1-batch-a",
    "source_branch": "rf/agent-capability-platform-v2",
    "base_resolution": "resolve origin/rf/agent-capability-platform-v2 at run time and record the resulting clean SHA",
    "integration_update": "fast_forward_only",
    "source_sha_in_manifest": false
  },
  "execution_policy": {
    "claim_threshold": "all_four_tasks",
    "max_writers": 3,
    "disjoint_write_sets_required": true,
    "central_integration_owner": "main host",
    "workspace_cargo_test": "forbidden_for_subagents",
    "mock_or_bypass": "forbidden",
    "secret_material": "never_commit_or_log"
  },
  "tasks": [
    {
      "task_id": "SL-S2-05",
      "writer_id": "session-data",
      "sequence": 1,
      "depends_on": [
        "SL-S2-04"
      ],
      "write_paths": [
        "crates/backend/nomifun-agent-session/src/**",
        "crates/backend/nomifun-agent-session/tests/**"
      ],
      "forbidden_paths": [
        "crates/backend/nomifun-agent-contracts/**",
        "crates/backend/nomifun-v4-root/**",
        "crates/backend/nomifun-agent-kernel/**",
        "crates/backend/nomifun-agent-control-plane/**",
        "crates/backend/nomifun-app/**",
        "docs/specs/2026-08-28-agent-capability-platform-v2/**",
        "Cargo.toml",
        "Cargo.lock"
      ],
      "deliverable": "Keep SessionEvent as the semantic source of truth; remove full events[] duplication from projections; persist only the final assistant message on normal completion and at most one bounded partial on interruption.",
      "required_checks": [
        "cargo fmt --all -- --check",
        "cargo check --locked -p nomifun-agent-session",
        "cargo test --locked -p nomifun-agent-session --lib -- --test-threads=1"
      ],
      "stop_conditions": [
        "a central contract or schema change is required",
        "a second event log or compatibility write is needed",
        "the failure is an unchanged environment or harness failure"
      ]
    },
    {
      "task_id": "SL-S2-06",
      "writer_id": "session-data",
      "sequence": 2,
      "depends_on": [
        "SL-S2-05",
        "SL-S1-01",
        "SL-S1-02"
      ],
      "write_paths": [
        "crates/backend/nomifun-agent-session/src/**",
        "crates/backend/nomifun-agent-session/tests/**"
      ],
      "forbidden_paths": [
        "crates/backend/nomifun-agent-contracts/**",
        "crates/backend/nomifun-v4-root/**",
        "crates/backend/nomifun-agent-kernel/**",
        "crates/backend/nomifun-agent-control-plane/**",
        "crates/backend/nomifun-app/**",
        "docs/specs/2026-08-28-agent-capability-platform-v2/**",
        "Cargo.toml",
        "Cargo.lock"
      ],
      "deliverable": "Use only read_only, managed_effect, and external_uncertain_effect strategies; keep local transaction/CAS/atomic behavior; prohibit automatic retry after an unknown external result; remove unconsumed generic journal/coordinator expansion.",
      "required_checks": [
        "cargo fmt --all -- --check",
        "cargo check --locked -p nomifun-agent-session",
        "cargo test --locked -p nomifun-agent-session --lib -- --test-threads=1"
      ],
      "stop_conditions": [
        "a global EffectCoordinator or second receipt state machine is proposed",
        "a central contract or schema change is required",
        "a live external effect cannot be isolated in a disposable sandbox"
      ]
    },
    {
      "task_id": "SL-S3-09",
      "writer_id": "ssh-owner",
      "sequence": 1,
      "depends_on": [
        "SL-S0-03"
      ],
      "write_paths": [
        "crates/backend/nomifun-ssh/src/**",
        "crates/backend/nomifun-ssh/tests/**",
        "crates/shared/nomi-ssh/src/**",
        "crates/shared/nomi-ssh/tests/**"
      ],
      "forbidden_paths": [
        "crates/backend/nomifun-app/**",
        "crates/backend/nomifun-gateway/**",
        "crates/backend/nomifun-agent-contracts/**",
        "crates/backend/nomifun-agent-kernel/**",
        "docs/specs/2026-08-28-agent-capability-platform-v2/**",
        "Cargo.toml",
        "Cargo.lock"
      ],
      "deliverable": "Keep or complete minimal typed ssh.fs.read, ssh.fs.write, ssh.exec, and ssh.sudo owners with bounded path/payload/output/timeout, separate exec and sudo credentials, explicit host-key/disconnect/timeout/cancel failures, and no automatic replay after an unknown result.",
      "required_checks": [
        "cargo fmt --all -- --check",
        "cargo check --locked -p nomi-ssh -p nomifun-ssh",
        "cargo test --locked -p nomi-ssh --lib",
        "cargo test --locked -p nomifun-ssh --lib",
        "cargo test --locked -p nomifun-ssh --tests -- --test-threads=1"
      ],
      "stop_conditions": [
        "a live sshd or sudo environment is unavailable",
        "an absolute atomicity proof or global uncertain platform is proposed",
        "a central host or Cargo file must change"
      ]
    },
    {
      "task_id": "SL-S2-10",
      "writer_id": "sidecar-spike",
      "sequence": 1,
      "depends_on": [],
      "write_paths": [
        "docs/specs/2026-08-28-agent-capability-platform-v2/SIDECAR-UPSTREAM-SPIKE.zh.md",
        "scripts/validation/codex-app-server-spike.mjs",
        "scripts/validation/codex-app-server-spike.test.mjs"
      ],
      "forbidden_paths": [
        "crates/backend/nomifun-codex-runtime/**",
        "crates/backend/nomifun-agent-contracts/**",
        "crates/backend/nomifun-agent-kernel/**",
        "crates/backend/nomifun-app/**",
        "docs/specs/2026-08-28-agent-capability-platform-v2/README.zh.md",
        "docs/specs/2026-08-28-agent-capability-platform-v2/05-system-capability-replacement-foundation.zh.md",
        "docs/specs/2026-08-28-agent-capability-platform-v2/GLOBAL-CLOSURE-TODO.zh.md",
        "docs/specs/2026-08-28-agent-capability-platform-v2/MACHINE-2-PHASE1-BATCH-A-START-PROMPT.zh.md",
        "docs/specs/2026-08-28-agent-capability-platform-v2/MACHINE-2-PHASE1-BATCH-A-MANIFEST.json",
        "docs/specs/2026-08-28-agent-capability-platform-v2/MACHINE-2-PHASE1-BATCH-A-RESULT-TEMPLATE.json",
        "Cargo.toml",
        "Cargo.lock"
      ],
      "deliverable": "On a pinned official Codex app-server checkout, record and smoke initialize/version, thread create/resume, turn/event, cancel, Host-managed Tool callback, and normal/forced process-tree shutdown. Decide whether a narrow patch is necessary; do not modify a production fork.",
      "required_checks": [
        "bun test scripts/validation/codex-app-server-spike.test.mjs",
        "bun scripts/validation/codex-app-server-spike.mjs --self-test"
      ],
      "stop_conditions": [
        "the upstream checkout or version cannot be pinned",
        "live credentials are required but unavailable",
        "a custom RPC is proposed without an upstream pre-effect seam finding"
      ]
    }
  ],
  "writer_lanes": [
    {
      "writer_id": "session-data",
      "tasks": [
        "SL-S2-05",
        "SL-S2-06"
      ],
