    {
      "name": "reordered_equivalent_schema_is_unified",
      "source": "openai.chat_text",
      "target": "openai.responses",
      "params": {
        "response_format": { "type": "json_schema", "json_schema": {
          "name": "answer", "schema": { "type": "object", "properties": { "a": { "type": "string" }, "b": { "type": "number" } } }, "strict": true
        } },
        "text": { "format": { "strict": true, "schema": { "properties": { "b": { "type": "number" }, "a": { "type": "string" } }, "type": "object" }, "name": "answer", "type": "json_schema" } }
      },
      "expected": {
        "params": { "text": { "format": { "strict": true, "schema": { "properties": { "b": { "type": "number" }, "a": { "type": "string" } }, "type": "object" }, "name": "answer", "type": "json_schema" } } },
        "suspended": {}, "issues": []
      }
    },
