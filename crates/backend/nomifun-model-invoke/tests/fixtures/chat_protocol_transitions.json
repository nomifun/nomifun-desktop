{
  "version": 1,
  "cases": [
    {
      "name": "chat_to_responses_transport_controls",
      "source": "openai.chat_text",
      "target": "openai.responses",
      "params": {
        "stream_options": {
          "include_usage": false
        },
        "require_reasoning_content": true,
        "max_tokens_field": "max_completion_tokens",
        "reasoning_effort": "high",
        "temperature": 0.3,
        "vendor": {
          "enabled": true
        }
      },
      "expected": {
        "params": {
          "reasoning_effort": "high",
          "temperature": 0.3,
          "vendor": {
            "enabled": true
          }
        },
        "suspended": {
          "stream_options": {
            "include_usage": false
          },
          "require_reasoning_content": true,
          "max_tokens_field": "max_completion_tokens"
        },
        "issues": []
      }
    },
    {
      "name": "responses_to_chat_transport_controls",
      "source": "openai.responses",
      "target": "openai.chat_text",
      "params": {
        "include": null,
        "chain_rounds": false,
        "max_tokens_field": "max_output_tokens",
        "reasoning_effort": "low"
      },
      "expected": {
        "params": {
          "reasoning_effort": "low"
        },
        "suspended": {
          "include": null,
          "chain_rounds": false,
          "max_tokens_field": "max_output_tokens"
        },
        "issues": []
      }
    },
