      "expected": {
        "params": {
          "text": {
            "format": {
              "type": "json_schema",
              "name": "answer",
              "description": "Answer schema",
              "strict": false,
              "schema": {
                "type": "object",
                "properties": {
                  "ok": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "ok"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "suspended": {},
        "issues": []
      }
