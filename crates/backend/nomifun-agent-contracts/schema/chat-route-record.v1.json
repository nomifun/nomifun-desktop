{
  "$defs": {
    "ChatRouteCandidate": {
      "additionalProperties": false,
      "properties": {
        "activation_features": {
          "description": "Features that must be required by the current request before this\ncandidate participates. Empty candidates are ordinary primary/failover\nroutes; an ImageInput-only auxiliary route cannot become a text-chat\nfailover merely because it is present in the same immutable record.",
          "items": {
            "$ref": "#/$defs/ChatRouteFeature"
          },
          "type": "array",
          "uniqueItems": true
        },
        "config_revision_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "connection_config_ref": {
          "minLength": 1,
          "type": "string"
        },
        "credential_ref": {
          "minLength": 1,
          "type": "string"
        },
        "features": {
          "contains": {
            "const": "text_output"
          },
          "items": {
            "$ref": "#/$defs/ChatRouteFeature"
          },
          "type": "array",
          "uniqueItems": true
        },
        "input_constraints": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelInputConstraints"
            },
            {
              "type": "null"
            }
          ]
        },
        "model": {
          "minLength": 1,
          "type": "string"
        },
        "model_route_id": {
          "minLength": 1,
          "type": "string"
        },
        "model_route_revision": {
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        },
        "protocol": {
          "$ref": "#/$defs/ChatRouteProtocol"
        },
        "provider_id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "model_route_id",
        "model_route_revision",
        "provider_id",
        "model",
        "protocol",
        "connection_config_ref",
        "config_revision_digest",
        "credential_ref",
        "features"
      ],
      "type": "object"
    },
    "ChatRouteFeature": {
      "oneOf": [
        {
          "enum": [
            "text_input",
            "image_input",
            "audio_input",
            "text_output",
            "audio_output",
            "tool_calls",
            "reasoning",
            "reasoning_signature",
            "prompt_cache",
            "structured_output",
            "provider_round_state",
            "native_responses_items"
          ],
          "type": "string"
        },
        {
          "const": "streaming",
          "description": "Provider incremental output is available. Runtime observations may\nremove this and use a bounded single-response transport instead.",
          "type": "string"
        },
        {
          "const": "web_search",
          "description": "Exact Chat route supports provider-native web search with source\nattribution (currently OpenAI Responses built-in `web_search`).",
          "type": "string"
        }
      ]
    },
    "ChatRouteProtocol": {
      "enum": [
        "anthropic",
        "openai_chat",
        "openai_responses",
        "gemini",
        "bedrock",
        "vertex"
      ],
      "type": "string"
    },
    "ChatRouteRecordSchema": {
      "enum": [
        "nomifun.chat-route-record.v1"
      ],
      "type": "string"
    },
    "ChatRouteTask": {
      "enum": [
        "agent_chat"
      ],
      "type": "string"
    },
    "ModelInputConstraints": {
      "additionalProperties": false,
      "description": "User-authored input limits for one configured model interface. Absence\npreserves protocol defaults; explicit support never expands its serializer.",
      "properties": {
        "image_input": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "type": "object"
    }
  },
  "$id": "nomifun.chat-route-record.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "failovers": {
      "items": {
        "$ref": "#/$defs/ChatRouteCandidate"
      },
      "type": "array"
    },
    "primary": {
      "$ref": "#/$defs/ChatRouteCandidate"
    },
    "schema": {
      "$ref": "#/$defs/ChatRouteRecordSchema"
    },
    "task": {
      "$ref": "#/$defs/ChatRouteTask"
    }
  },
  "required": [
    "schema",
    "task",
    "primary",
    "failovers"
  ],
  "title": "ChatRouteRecord",
  "type": "object"
}
