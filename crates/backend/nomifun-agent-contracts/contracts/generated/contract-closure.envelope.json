    "decisions": [
      {
        "decision_id": "D-001",
        "status": "confirmed",
        "contract": "Product uses Agent Preset; runtime instance uses AgentSession."
      },
      {
        "decision_id": "D-002",
        "status": "confirmed",
        "contract": "FullAuto is the only execution behavior; no product approval modes."
      },
      {
        "decision_id": "D-003",
        "status": "confirmed",
        "contract": "NomiFun owns capability, session, preset, authority, credentials, and domain facts."
      },
      {
        "decision_id": "D-004",
        "status": "confirmed",
        "contract": "One Codex-derived sidecar runtime replaces Nomi while preserving complete Coding."
      },
      {
        "decision_id": "D-005",
        "status": "confirmed",
        "contract": "Ordinary first-party and third-party plugins are trusted in-process code."
      },
      {
        "decision_id": "D-006",
        "status": "confirmed",
        "contract": "Thin Functional Kernel is closed; all business domains are plugins."
      },
      {
        "decision_id": "D-007",
        "status": "confirmed",
        "contract": "Package, Capability, Skill, and MCP are the four product layers; Capability is executable."
      },
      {
        "decision_id": "D-008",
        "status": "confirmed",
        "contract": "Preset has initial and on-demand capability sets resolved once before Session creation."
      },
      {
        "decision_id": "D-009",
        "status": "confirmed",
        "contract": "The official preset key exact-set contains seven role presets."
      },
      {
        "decision_id": "D-010",
        "status": "confirmed",
        "contract": "Agent Preset uses one progressive editor; package, capability, skill, and MCP navigation remain separate."
      },
      {
        "decision_id": "D-011",
        "status": "confirmed",
        "contract": "First final-stack gate contains chat.minimal, coding.codex, and CI-only sample.echo."
      },
      {
        "decision_id": "D-012",
        "status": "confirmed",
        "contract": "v4 is a clean start with no legacy data conversion or compatibility read."
      },
      {
        "decision_id": "D-013",
        "status": "confirmed",
        "contract": "First v4 cutover performs one same-filesystem whole-root rename before creating an empty v4 root."
      },
      {
        "decision_id": "D-014",
        "status": "confirmed",
        "contract": "Every migration slice switches all direct consumers and deletes the replaced legacy surface in the same change."
      },
      {
        "decision_id": "D-015",
        "status": "confirmed",
        "contract": "Canonical semantic SessionEvent facts are authoritative; projections rebuild and checkpoints are disposable."
      },
      {
        "decision_id": "D-016",
        "status": "confirmed",
        "contract": "Stable freezes a vendor-neutral seam; local install and one SDK begin only in Phase N1."
      },
      {
        "decision_id": "D-017",
        "status": "confirmed",
        "contract": "RemoteBinding selects an exact AgentBindingValue and uses explicit open, turn, observe, and cancel."
      },
      {
        "decision_id": "D-018",
        "status": "confirmed",
        "contract": "Lightweight Chat and complete Coding are structural conformance requirements, not a performance benchmark program."
      },
      {
        "decision_id": "D-019",
        "status": "confirmed",
        "contract": "Five owner workstreams, six to eight coding agents, disjoint writes, staged gates, and 213/314 EW are fixed."
      },
      {
        "decision_id": "D-020",
        "status": "confirmed",
        "contract": "Internal sticky canary precedes physical Nomi deletion, Nomi-free RC, and same-artifact Stable promotion."
      },
      {
        "decision_id": "D-021",
        "status": "confirmed",
        "contract": "AgentSessionId UUIDv7 is the only product and execution session identity; Conversation is absent from v4."
      },
      {
        "decision_id": "D-022",
        "status": "confirmed",
        "contract": "Editor Test saves or reuses an ordinary revision, creates an ordinary persistent Session, and performs real FullAuto effects."
      },
      {
        "decision_id": "D-023",
        "status": "confirmed",
        "contract": "Official seeds are role-complete and context-minimal; G0 freezes their exact contribution manifest."
      },
      {
        "decision_id": "D-024",
        "status": "confirmed",
        "contract": "One irreversible delete closure purges Session content and leaves only the four-field tombstone semantics."
      },
      {
        "decision_id": "D-025",
        "status": "confirmed",
        "contract": "Exact complete-ceiling compatibility continues the same Session; incompatibility is read-only and requires explicit fork."
      },
      {
        "decision_id": "D-026",
        "status": "confirmed",
        "contract": "Remote token rotate or revoke fences new request admission and never cascades to existing Sessions."
      },
      {
        "decision_id": "D-027",
        "status": "confirmed",
        "contract": "Nomi drain uses existing finite deadlines, forced cleanup, uncertain handoff, exact zero, and D-024 delete."
      },
      {
        "decision_id": "D-028",
        "status": "confirmed",
        "contract": "Five required native cells use Windows-first whole-candidate handoff and whole-cohort recheck."
      }
    ],
