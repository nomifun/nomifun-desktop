{
  "message_timeline": {
    "$defs": {
      "MessageTimelineSegment": {
        "additionalProperties": false,
        "properties": {
          "call_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "end_utf16": {
            "format": "uint64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "first_seq": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "group_id": {
            "description": "Stable process anchor: the accepted root, or preceding narration segment.\nNarration itself is independent of process disclosure.",
            "type": "string"
          },
          "kind": {
            "$ref": "#/$defs/TimelineSegmentKind"
          },
          "last_seq": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "segment_id": {
            "description": "The first canonical event in this uninterrupted source segment.",
            "type": "string"
          },
          "start_utf16": {
            "description": "Half-open range in the owning projection's content, measured in UTF-16\ncode units, matching JavaScript String.slice. Absent for tool segments.",
            "format": "uint64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "state": {
            "$ref": "#/$defs/TimelineSegmentState"
          }
        },
        "required": [
          "segment_id",
          "group_id",
          "first_seq",
          "last_seq",
          "kind",
          "state"
        ],
        "type": "object"
      },
      "TimelineSegmentKind": {
        "enum": [
          "reasoning",
          "narration",
          "tool"
        ],
        "type": "string"
      },
      "TimelineSegmentState": {
        "enum": [
          "running",
          "completed",
          "failed",
          "cancelled",
          "interrupted"
        ],
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "segments": {
        "items": {
          "$ref": "#/$defs/MessageTimelineSegment"
        },
        "type": "array"
      },
      "through_seq": {
        "description": "Exact committed Session cursor of the read snapshot used by this view.",
        "format": "uint64",
        "minimum": 0,
        "type": "integer"
      }
    },
    "required": [
      "through_seq",
      "segments"
    ],
    "title": "MessageTimeline",
    "type": "object"
  },
  "message_timeline_update": {
    "$defs": {
      "MessageTimeline": {
        "additionalProperties": false,
        "properties": {
          "segments": {
            "items": {
              "$ref": "#/$defs/MessageTimelineSegment"
            },
            "type": "array"
          },
          "through_seq": {
            "description": "Exact committed Session cursor of the read snapshot used by this view.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "through_seq",
          "segments"
        ],
        "type": "object"
      },
      "MessageTimelineSegment": {
        "additionalProperties": false,
        "properties": {
          "call_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "end_utf16": {
            "format": "uint64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "first_seq": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "group_id": {
            "description": "Stable process anchor: the accepted root, or preceding narration segment.\nNarration itself is independent of process disclosure.",
            "type": "string"
          },
          "kind": {
            "$ref": "#/$defs/TimelineSegmentKind"
          },
          "last_seq": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "segment_id": {
            "description": "The first canonical event in this uninterrupted source segment.",
            "type": "string"
          },
          "start_utf16": {
            "description": "Half-open range in the owning projection's content, measured in UTF-16\ncode units, matching JavaScript String.slice. Absent for tool segments.",
            "format": "uint64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "state": {
            "$ref": "#/$defs/TimelineSegmentState"
          }
        },
        "required": [
          "segment_id",
          "group_id",
          "first_seq",
          "last_seq",
          "kind",
          "state"
        ],
        "type": "object"
      },
      "TimelineSegmentKind": {
        "enum": [
          "reasoning",
          "narration",
          "tool"
        ],
        "type": "string"
      },
      "TimelineSegmentState": {
        "enum": [
          "running",
          "completed",
          "failed",
          "cancelled",
          "interrupted"
        ],
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "call_id": {
        "description": "Tool consumers match this within the exact Turn, because live display\nmessage identities need not equal historical tool projection identities.",
        "type": [
          "string",
          "null"
        ]
      },
      "source_message_id": {
        "description": "Correlation identity of the canonical owning message projection.",
        "type": "string"
      },
      "timeline": {
        "$ref": "#/$defs/MessageTimeline"
      }
    },
    "required": [
      "source_message_id",
      "timeline"
    ],
    "title": "MessageTimelineUpdate",
    "type": "object"
  },
  "runtime_tool_hold_reason": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "One proposal did not reach its owner port. This is neither an authority\ndecision nor an Effect/Turn outcome. A write-ahead admission intent may\nalready exist; earlier calls and their receipts remain unchanged.",
    "enum": [
      "tool_not_exposed",
      "arguments_rejected",
      "batch_rejected",
      "phase_restricted",
      "input_superseded",
      "prior_call_failed",
      "runtime_gate"
    ],
    "title": "RuntimeToolHoldReason",
    "type": "string"
  },
  "system_execution_failure": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "The original native system owner failure. Optional facts remain unknown\nwhen that owner did not report them; cleanup does not prove non-dispatch.",
    "properties": {
      "cleanup_proven": {
        "default": null,
        "type": [
          "boolean",
          "null"
        ]
      },
      "code": {
        "type": "string"
      },
      "kind": {
        "default": null,
        "type": [
          "string",
          "null"
        ]
      },
      "message": {
        "type": "string"
      },
      "raw_os_error": {
        "default": null,
        "format": "int32",
        "type": [
          "integer",
          "null"
        ]
      },
      "user_code_not_started": {
        "default": null,
        "type": [
          "boolean",
          "null"
        ]
      }
    },
    "required": [
      "code",
      "message"
    ],
    "title": "SystemExecutionFailure",
    "type": "object"
  },
  "tool_detail_page": {
    "$defs": {
      "ToolDetailAvailability": {
        "enum": [
          "available",
          "pending",
          "unconfirmed"
        ],
        "type": "string"
      },
      "ToolDetailFormat": {
        "enum": [
          "json",
          "text"
        ],
        "type": "string"
      },
      "ToolDetailRetention": {
        "additionalProperties": false,
        "properties": {
          "decode_errors": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "dropped_bytes": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "next_cursor": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "retained_bytes": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "source_encoding": {
            "type": "string"
          }
        },
        "required": [
          "next_cursor",
          "retained_bytes",
          "dropped_bytes",
          "source_encoding",
          "decode_errors"
        ],
        "type": "object"
      },
      "ToolDetailSection": {
        "enum": [
          "arguments",
          "output"
        ],
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "availability": {
        "$ref": "#/$defs/ToolDetailAvailability",
        "description": "Output absence is independent of the tool's execution status. Available\nwith zero bytes means a committed empty output, not a missing result."
      },
      "call_event_id": {
        "type": "string"
      },
      "call_id": {
        "type": "string"
      },
      "content": {
        "type": "string"
      },
      "eof": {
        "type": "boolean"
      },
      "format": {
        "$ref": "#/$defs/ToolDetailFormat"
      },
      "next_cursor": {
        "type": [
          "string",
          "null"
        ]
      },
      "non_text_parts": {
        "description": "Media stays in the existing verified artifact paths, never inline base64.",
        "format": "uint32",
        "minimum": 0,
        "type": "integer"
      },
      "offset": {
        "description": "UTF-8 byte offsets in this immutable presentation section.",
        "format": "uint64",
        "minimum": 0,
        "type": "integer"
      },
      "result_seq": {
        "format": "uint64",
        "minimum": 0,
        "type": [
          "integer",
          "null"
        ]
      },
      "retention": {
        "anyOf": [
          {
            "$ref": "#/$defs/ToolDetailRetention"
          },
          {
            "type": "null"
          }
        ],
        "description": "Original native observation bounds, not a claim of complete process\nhistory. Present only for an exact admitted native process Action."
      },
      "section": {
        "$ref": "#/$defs/ToolDetailSection"
      },
      "through_seq": {
        "format": "uint64",
        "minimum": 0,
        "type": "integer"
      },
      "total_bytes": {
        "format": "uint64",
        "minimum": 0,
        "type": "integer"
      },
      "turn_id": {
        "type": "string"
      },
      "working_directory": {
        "description": "Original explicitly supplied cwd, never the current workspace or disk.",
        "type": [
          "string",
          "null"
        ]
      }
    },
    "required": [
      "turn_id",
      "call_id",
      "call_event_id",
      "through_seq",
      "section",
      "availability",
      "content",
      "format",
      "offset",
      "total_bytes",
      "eof",
      "non_text_parts"
    ],
    "title": "ToolDetailPage",
    "type": "object"
  },
  "tool_file_summary": {
    "$defs": {
      "ToolFileEntry": {
        "additionalProperties": false,
        "properties": {
          "added_lines": {
            "description": "Applied patch lines for this invocation, never a current workspace diff.",
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "destination": {
            "type": [
              "string",
              "null"
            ]
          },
          "path": {
            "description": "Original requested path; preserve legal whitespace and native spelling.",
            "type": "string"
          },
          "removed_lines": {
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "path"
        ],
        "type": "object"
      },
      "ToolFileOperation": {
        "enum": [
          "read",
          "write",
          "patch",
          "delete",
          "rename"
        ],
        "type": "string"
      },
      "ToolFileSummaryKind": {
        "enum": [
          "instruction_scope"
        ],
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "files": {
        "description": "One target for simple actions; at most the native patch contract's 64.",
        "items": {
          "$ref": "#/$defs/ToolFileEntry"
        },
        "type": "array"
      },
      "kind": {
        "anyOf": [
          {
            "$ref": "#/$defs/ToolFileSummaryKind"
          },
          {
            "type": "null"
          }
        ],
        "description": "Directory instruction metadata does not claim to read every file below it."
      },
      "operation": {
        "$ref": "#/$defs/ToolFileOperation"
      }
    },
    "required": [
      "operation",
      "files"
    ],
    "title": "ToolFileSummary",
    "type": "object"
  }
}
