{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NomiFun",
  "identifier": "com.nomifun.desktop",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run --filter=./ui dev",
    "beforeBuildCommand": "bun scripts/prune-build.mjs --pre && bun run --filter=./ui build"
  },
  "app": {
    "windows": [],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "externalBin": ["binaries/nomifun-computer-worker"],
    "targets": [
      "nsis",
      "app",
      "dmg",
      "appimage",
      "deb",
      "rpm"
    ],
    "resources": {
      "../../LICENSE": "LICENSE",
      "../../NOTICE": "NOTICE",
      "../../crates/backend/nomifun-runtime/notices/": "component-notices/",
      "keyboard-packaging/": "keyboard-packaging/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "entitlements": "entitlements.plist"
    },
    "linux": {
      "deb": {
        "preInstallScript": "keyboard-packaging/deb-preinstall.sh",
        "preRemoveScript": "keyboard-packaging/deb-preremove.sh",
        "postInstallScript": "keyboard-packaging/udev-refresh.sh",
        "postRemoveScript": "keyboard-packaging/udev-refresh.sh",
        "files": {
          "/usr/lib/nomifun-keyboard/package-lifecycle.sh": "keyboard-packaging/package-lifecycle.sh",
          "/usr/lib/udev/rules.d/70-nomifun-keyboard.rules": "keyboard-packaging/70-nomifun-keyboard.rules"
        }
      },
      "rpm": {
        "preInstallScript": "keyboard-packaging/rpm-preinstall.sh",
        "preRemoveScript": "keyboard-packaging/rpm-preremove.sh",
        "postInstallScript": "keyboard-packaging/udev-refresh.sh",
        "postRemoveScript": "keyboard-packaging/udev-refresh.sh",
        "files": {
          "/usr/lib/nomifun-keyboard/package-lifecycle.sh": "keyboard-packaging/package-lifecycle.sh",
          "/usr/lib/udev/rules.d/70-nomifun-keyboard.rules": "keyboard-packaging/70-nomifun-keyboard.rules"
        }
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "template": "nsis/installer.nsi",
        "installerHooks": "nsis/keyboard-hooks.nsh"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "nomifun"
        ]
      }
    },
    "updater": {
      "endpoints": [
        "https://cdn.crabnebula.app/update/nomifun/nomifun-desktop/{{target}}-{{arch}}/{{current_version}}",
        "https://github.com/nomifun/nomifun-desktop/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYzQUEyNzJFNjBBQTc5NTIKUldSU2VhcGdMaWVxODRRbUdXczZodEJZOE1Ja2Zta011eWUxUko2SG5XclVaSUdtaWNobXJNemEK"
    }
  }
}
