# Copy to `.env.release` (gitignored) and fill in the credentials needed by the
# GitHub and/or CrabNebula release commands.
#
# The release scripts read GH_TOKEN from this file and export it for the `gh`
# CLI so uploads need no interactive `gh auth login`. Two token types work:
#   - Classic PAT with the `repo` scope
#   - Fine-grained PAT scoped to nomifun/nomifun-desktop with Contents: Read and write
#
# Keep it short-lived and revoke when no longer needed.
GH_TOKEN=ghp_<your_token>

# CrabNebula Cloud. Create the application and API key in its dashboard first.
# Never commit the real key.
CN_API_KEY=<your_api_key>
CN_APP=nomifun/nomifun-desktop

# Optional: share one draft ID between the Windows/macOS/Linux build machines.
# CN_RELEASE_ID=01HXXXXXXXXXXXXXXXXXXXXXXX
